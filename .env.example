# Portfolio EG — environment template.
#
# Copy to .env.local and fill in what you have. Every value below is optional:
# with an empty file the app boots, and each feature that needs a key reports
# it as unavailable rather than inventing data.
#
#   cp .env.example .env.local
#
# .env.local is gitignored. Never prefix a secret with NEXT_PUBLIC_ — that
# prefix ships the value to the browser.


# ---------------------------------------------------------------- market data

# Finnhub free tier — fundamentals, financial statements, analyst counts.
# https://finnhub.io/register  (60 requests/minute)
#
# This is the one that matters most. Without it the scanner and screener can
# still filter the listing by size, sector and price, but no valuation,
# profitability or growth metric is available, so nothing can be scored.
FINNHUB_API_KEY=

# Twelve Data — quotes and history for symbols the free sources do not cover.
# https://twelvedata.com/pricing  (800 requests/day on the free plan)
#
# Optional. Yahoo, Nasdaq and CNBC cover most symbols without a key; this is
# the fallback for the rest, mainly indices and some FX.
TWELVE_DATA_API_KEY=

# Daily ceiling for the above, so a loop cannot burn the whole allowance.
TWELVEDATA_DAILY_BUDGET=750


# ------------------------------------------------------------------------ AI

# Anthropic — the executive brief, investment committee and portfolio builder.
# https://console.anthropic.com/
#
# Optional, and never called automatically: every AI feature in this app runs
# on an explicit button press. Leave it empty and those buttons say the key is
# missing; nothing else changes.
ANTHROPIC_API_KEY=


# ------------------------------------------- accounts and persistence

# Supabase. https://supabase.com/dashboard → Project Settings → API
#
# REQUIRED for any shared or public deployment. These three together are what
# turn the app from a single-user tool into a multi-account one: without them
# there are no accounts, and every visitor would share one set of holdings.
#
# The URL and anon key are public by design — they are safe in the browser and
# are what carries a signed-in user's JWT. Isolation comes from the row-level
# policies in data/auth-multiuser.sql, not from hiding the anon key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only. Bypasses row-level security, so it is used for public
# reference data (congress filings, job snapshots) and never for anything an
# account owns. Never give this a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=


# --------------------------------------------- third-source verification

# SearchApi — Google Finance statements, used only to break a tie.
# https://www.searchapi.io
#
# Optional and deliberately hard to spend. Filed figures are already derived
# twice (SEC filings and Finnhub); this is the third opinion for the rows where
# those two disagree. It is never called on a page render, never by the scanner
# and never by a background pass — only by an explicit click, and an answer is
# cached for a week in the shared store so a company is paid for once.
#
# Note the plan: credits are a fixed pool, not a monthly allowance. The
# provider refuses below a small reserve rather than draining it.
SEARCHAPI_KEY=


# ---------------------------------------------------- operator notifications

# Emails you when an account is created or signs in. Optional; with no key the
# app behaves exactly the same and sends nothing.
#
# Account details only — address, user id, time, IP. Holdings, alerts, paper
# trades and saved screens are never included: they belong to the account that
# created them, and the sign-in page says so.
#
# https://resend.com — free tier is 100 emails/day.
RESEND_API_KEY=
OWNER_NOTIFY_EMAIL=
# Must be a sender Resend has verified. Leave empty to use their sandbox one.
NOTIFY_FROM_EMAIL=


# -------------------------------------------------------------- portfolio

# Path to your holdings workbook, relative to the project root or absolute.
# Defaults to data/Portfoy_Tahsisi.xlsx. You can also upload one at /settings
# instead of setting this.
#
# Your own workbook is gitignored and is not part of this package.
PORTFOLIO_FILE=
