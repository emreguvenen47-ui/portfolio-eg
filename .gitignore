# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template carries no values and is how a recipient knows which
# keys exist at all.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.provider-usage.json
.snapshot.json

# local dev fallback store (used until the Supabase migrations are run)
/data/.dev-store/
data/.cache/
# Personal holdings. Never packaged for distribution — a recipient uploads
# their own workbook on /settings, or points PORTFOLIO_FILE at one.
data/*.xlsx
